#!/usr/bin/env bash
# Displays the DNS record type and destination of a domain's subdomains
audit () {
    dig "$2.$1" | awk -v s="$2" '/ANSWER SECTION:/ {getline; print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ -z "$2" ]; then
    for sub in www lb-01 web-01 web-02; do
        audit "$1" "$sub"
    done
else
    audit "$1" "$2"
fi
