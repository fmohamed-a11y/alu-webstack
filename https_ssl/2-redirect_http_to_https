global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option forwardfor
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    http-request redirect scheme https code 301 unless { ssl_fc }
    bind *:80
    default_backend http_back

frontend https_front
    bind *:443 ssl crt /etc/haproxy/certs/www.dodoon.tech.pem
    http-request set-header X-Forwarded-Proto https
    default_backend http_back

backend http_back
    balance roundrobin
    server 7343-web-01 13.40.29.172:80 check
    server 7343-web-02 16.60.12.170:80 check
